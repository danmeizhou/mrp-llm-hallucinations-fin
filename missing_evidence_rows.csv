33,CRA,At what point should contributions be made to a Registered Retirement Savings Plan (RRSP)?,open_ended,,,error,"{
  ""source_url"": ""https://www.canada.ca/en/revenue-agency/services/tax/individuals/topics/rrsps-related-plans/registered-retirement-savings-plan-rrsp.html"",
  ""evidence_text"": ""You generally have to pay tax when you receive payments from the plan."",
  ""evidence_status"": ""insufficient"",
  ""notes"": ""This text does not directly answer the question about when to make contributions to an RRSP.""
}

{
  ""source_url"": ""https://www.canada.ca/en/revenue-agency/services/tax/individuals/topics/rrsps-related-plans/setting-rrsp.html"",
  ""evidence_text"": ""You make your RRSP contributions directly to the RRSP issuer."",
  ""evidence_status"": ""found"",
  ""notes"": ""This text directly answers the question about when to make contributions to an RRSP.""
}

{
  ""source_url"": ""https://www.canada.ca/en/revenue-agency/services/tax/businesses/topics/payroll/benefits-allowances/benefits-allowances-chart/saving-pensions.html"",
  ""evidence_text"": ""Non-taxable situations You withhold contributions from the salary If you withhold contributions to any savings or pension plan from your employee’s salary, the benefit is not taxable."",
  ""evidence_status"": ""insufficient"",
  ""notes"": ""This text does not directly answer the question about when to make contributions to an RRSP.""
}

{
  ""source_url"": ""https://www.canada.ca/en/revenue-agency/services/tax/individuals/topics/rrsps-related-plans/important-dates-rrsp-rrif-rdsp.html"",
  ""evidence_text"": ""March 2, 2026 is the deadline for contributing to an RRSP for the 2025 tax year."",
  ""evidence_status"": ""found"",
  ""notes"": ""This text directly answers the question about when to make contributions to an RRSP.""
}

{
  ""source_url"": ""https://www.canada.ca/en/revenue-agency/services/tax/individuals/topics/rrsps-related-plans/contributing-a-rrsp-prpp/questions-answers-about-contributing-rrsp.html"",
  ""evidence_text"": ""Can a deceased individual's legal representative contribute to the individual's RRSP after the date of death? No."",
